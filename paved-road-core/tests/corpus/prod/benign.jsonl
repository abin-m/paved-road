{"label": "aws eks update-kubeconfig prod", "bash": "aws eks update-kubeconfig --name prod-cluster"}
{"label": "aws sso login prod", "bash": "aws sso login --profile prod"}
{"label": "aws configure list prod", "bash": "aws configure list --profile prod"}
