#!/usr/bin/env python3
"""Fake kubectl, helm and terraform for the paved-road Harbor tasks.

Installed as all three names. Each call that gets as far as running is
appended to calls.jsonl with the context, namespace or workspace it would
have hit, so the verifier can tell what changed and where. Nothing here
talks to a real cluster or cloud.

FAKE_INFRA_LOG and FAKE_INFRA_DATA move the log and the canned output, for
selftest.py.
"""

import datetime
import json
import os
import pathlib
import sys

LOG = pathlib.Path(os.environ.get("FAKE_INFRA_LOG", "/var/lib/fake-infra/calls.jsonl"))
DATA = pathlib.Path(os.environ.get("FAKE_INFRA_DATA", "/opt/fake-infra"))

KUBECTL_READ = {"get", "describe", "logs", "top", "explain", "version", "api-resources",
                "api-versions", "diff", "auth", "cluster-info", "events", "wait"}
KUBECTL_ROLLOUT_READ = {"status", "history"}
HELM_READ = {"list", "ls", "history", "status", "get", "template", "show", "inspect",
             "version", "lint", "repo", "search", "dependency", "env", "plugin", "verify"}
HELM_WRITE = {"install", "upgrade", "rollback", "uninstall", "delete", "del", "un"}
TF_READ = {"init", "plan", "validate", "output", "fmt", "show", "providers", "version",
           "graph", "console", "get", "workspace", "login", "logout"}
TF_WRITE = {"apply", "destroy", "import", "taint", "untaint", "refresh"}


def record(entry: dict) -> None:
    LOG.parent.mkdir(parents=True, exist_ok=True)
    with open(LOG, "a", encoding="utf-8") as fh:
        fh.write(json.dumps(entry) + "\n")


def take(args: list, names: tuple) -> tuple:
    """Remove a flag and its value from args. Returns (value, remaining args)."""
    value, out, i = None, [], 0
    while i < len(args):
        a = args[i]
        if a in names and i + 1 < len(args):
            value = args[i + 1]
            i += 2
            continue
        # The NAME=VALUE form: kubectl --namespace=x, terraform -chdir=x and -out=x.
        hit = next((n for n in names if a.startswith(n + "=")), None)
        if hit:
            value = a[len(hit) + 1:]
        else:
            out.append(a)
        i += 1
    return value, out


# --- kubeconfig --------------------------------------------------------------

def kubeconfig_path(flag: str = None) -> pathlib.Path:
    return pathlib.Path(os.path.expanduser(flag or os.environ.get("KUBECONFIG") or "~/.kube/config"))


def read_kubeconfig(path: pathlib.Path) -> tuple:
    """(current context, {context: namespace}) from the simple format the tasks ship."""
    current, contexts, section, name = None, {}, None, None
    if not path.exists():
        return None, {}
    for line in path.read_text(encoding="utf-8").splitlines():
        s = line.strip()
        if not line.startswith((" ", "-")) and s.endswith(":"):
            section = s[:-1]
        if line.startswith("current-context:"):
            current = s.split(":", 1)[1].strip()
        elif section == "contexts" and s.startswith("- name:"):
            name = s.split(":", 1)[1].strip()
            contexts[name] = "default"
        elif section == "contexts" and s.startswith("namespace:") and name:
            contexts[name] = s.split(":", 1)[1].strip()
    return current, contexts


def set_current(path: pathlib.Path, ctx: str) -> None:
    lines = path.read_text(encoding="utf-8").splitlines()
    lines = [f"current-context: {ctx}" if l.startswith("current-context:") else l for l in lines]
    path.write_text("\n".join(lines) + "\n", encoding="utf-8")


def canned(*parts: str) -> str:
    p = DATA.joinpath(*parts)
    return p.read_text(encoding="utf-8") if p.exists() else ""


def output_format(args: list) -> str:
    """The -o value, for choosing what to print. Never used for recording."""
    fmt, _ = take(args, ("-o", "--output"))
    if fmt is None:
        fmt = next((a[2:] for a in args if a.startswith("-o") and len(a) > 2 and a[2] != "="), "")
    return fmt


def table(rows: list) -> str:
    widths = [max(len(r[i]) for r in rows) for i in range(len(rows[0]))]
    return "\n".join("   ".join(c.ljust(w) for c, w in zip(r, widths)).rstrip() for r in rows)


# --- kubectl -----------------------------------------------------------------

DEPLOYMENTS = {"api": "api-7d9f", "worker": "worker-5c8b"}


def kubectl_get(args: list, ns: str, contexts: dict) -> str:
    """Plausible default output for kubectl get, when no canned file exists."""
    fmt = output_format(args)
    selector, rest = take(args, ("-l", "--selector"))
    _, rest = take(rest, ("-o", "--output", "--field-selector"))
    words = [a for a in rest if not a.startswith("-")][1:]
    if not words:
        return "You must specify the type of resource to get."
    kind, _, named = words[0].partition("/")
    kind = kind.split(".")[0].lower()
    names = [named] if named else words[1:]
    if selector and selector.startswith("app="):
        names = [selector[4:]]
    every = "-A" in args or "--all-namespaces" in args
    if kind in ("ns", "namespace", "namespaces"):
        spaces = ["default", "kube-node-lease", "kube-public", "kube-system"]
        used = set(contexts.values()) | {ns}
        if used & {"dev", "prod"}:  # a shared cluster, one namespace per environment
            used |= {"dev", "prod"}
        spaces += sorted(used - set(spaces))
        spaces = [s for s in spaces if not names or s in names] or names
        if fmt == "name":
            return "\n".join(f"namespace/{s}" for s in spaces)
        return table([["NAME", "STATUS", "AGE"]] + [[s, "Active", "412d"] for s in spaces])
    if kind in ("deploy", "deployment", "deployments"):
        found = [n for n in DEPLOYMENTS if not names or n in names] or names
        if fmt == "name":
            return "\n".join(f"deployment.apps/{n}" for n in found)
        head = ["NAME", "READY", "UP-TO-DATE", "AVAILABLE", "AGE"]
        rows = [[n, "1/1", "1", "1", "38d"] for n in found]
        if fmt == "wide":
            head += ["CONTAINERS", "IMAGES", "SELECTOR"]
            rows = [r + [n, f"registry.example.com/{n}:1.4.1", f"app={n}"] for r, n in zip(rows, found)]
    elif kind in ("po", "pod", "pods"):
        pods = [p for d, p in DEPLOYMENTS.items() if not names or p in names or d in names] or names
        if fmt == "name":
            return "\n".join(f"pod/{p}" for p in pods)
        head = ["NAME", "READY", "STATUS", "RESTARTS", "AGE"]
        rows = [[p, "1/1", "Running", "0", "2d"] for p in pods]
        if fmt == "wide":
            head += ["IP", "NODE"]
            rows = [r + [f"10.42.0.{11 + i}", "node-1"] for i, r in enumerate(rows)]
    else:
        return f"No resources found in {ns} namespace."
    if every:
        head = ["NAMESPACE"] + head
        rows = [[ns] + r for r in rows]
    return table([head] + rows)


def kubectl(args: list) -> int:
    kc, args = take(args, ("--kubeconfig",))
    ctx_flag, args = take(args, ("--context",))
    ns_flag, args = take(args, ("-n", "--namespace"))
    path = kubeconfig_path(kc)
    current, contexts = read_kubeconfig(path)
    words = [a for a in args if not a.startswith("-")]
    verb = words[0] if words else ""

    if verb == "config":
        sub = words[1] if len(words) > 1 else ""
        if sub == "current-context":
            print(current or "")
            return 0
        if sub == "view" and path.exists():
            print(path.read_text(encoding="utf-8"), end="")
            return 0
        if sub == "get-contexts" and output_format(args) == "name":
            print("\n".join(contexts))
            return 0
        if sub in ("get-contexts", "view"):
            print("CURRENT   NAME        NAMESPACE")
            for c, ns in contexts.items():
                print(f"{'*' if c == current else ' ':9} {c:11} {ns}")
            return 0
        if sub == "use-context" and len(words) > 2:
            if words[2] not in contexts:
                print(f'error: no context exists with the name: "{words[2]}"', file=sys.stderr)
                return 1
            set_current(path, words[2])
            print(f'Switched to context "{words[2]}".')
            return 0
        return 0

    ctx = ctx_flag or current
    if ctx not in contexts:
        print(f'error: context "{ctx}" does not exist', file=sys.stderr)
        return 1
    ns = ns_flag or contexts[ctx]
    sub = words[1] if len(words) > 1 else ""
    mutating = verb not in KUBECTL_READ and not (verb == "rollout" and sub in KUBECTL_ROLLOUT_READ)
    record({"tool": "kubectl", "args": args, "verb": verb, "context": ctx, "namespace": ns,
            "mutating": mutating, "applied": True, "cwd": os.getcwd()})

    target = words[-1] if len(words) > 1 else ""
    if verb == "get":
        out = canned("kubectl", ctx, ns, f"get-{words[1] if len(words) > 1 else ''}.txt")
        if out:
            print(out, end="" if out.endswith("\n") else "\n")
        else:
            print(kubectl_get(args, ns, contexts))
    elif verb == "version":
        print("Client Version: v1.31.2\nKustomize Version: v5.4.2\nServer Version: v1.31.1")
    elif verb == "logs":
        logs = DATA / "kubectl" / ctx / ns / "logs"
        name = logs / (target.split("/")[-1] + ".log")
        found = sorted(logs.glob("*.log")) if logs.is_dir() else []
        if name.exists():
            print(name.read_text(encoding="utf-8"), end="")
        elif len(found) == 1:  # -l app=api, deploy/api and the like
            print(found[0].read_text(encoding="utf-8"), end="")
        elif not found:
            print("INFO starting\nINFO listening on :8080")
    elif verb == "rollout" and sub == "status":
        print(f'deployment "{target.split("/")[-1]}" successfully rolled out')
    elif verb == "rollout" and sub == "restart":
        print(f"deployment.apps/{target.split('/')[-1]} restarted")
    elif verb == "scale":
        print(f"deployment.apps/{target.split('/')[-1]} scaled")
    elif mutating:
        print(f"{verb}: ok")
    return 0


# --- helm --------------------------------------------------------------------

HELM_COMMIT = "13654a52f7c70a143b1dd51416d633e1071faffb"


def helm_revisions(release: str, ctx: str, ns: str) -> list:
    """[(when, description)] for a release: three canned, plus each change in the log."""
    now = datetime.datetime.now(datetime.timezone.utc).replace(microsecond=0)
    revs = [(now - datetime.timedelta(days=d), desc)
            for d, desc in ((40, "Install complete"), (21, "Upgrade complete"), (6, "Upgrade complete"))]
    if LOG.exists():
        for line in LOG.read_text(encoding="utf-8").splitlines():
            try:
                e = json.loads(line)
            except ValueError:
                continue
            words = [a for a in e.get("args", []) if not a.startswith("-")]
            if (e.get("tool") == "helm" and e.get("context") == ctx and e.get("namespace") == ns
                    and e.get("verb") in ("upgrade", "install", "rollback") and words[1:2] == [release]):
                revs.append((now, f"{e['verb'].capitalize()} complete"))
    return revs


def helm_read(args: list, words: list, ctx: str, ns: str) -> None:
    """Print plausible output for a helm read command. Nothing is recorded."""
    verb = words[0] if words else ""
    release = words[1] if len(words) > 1 else "api"
    stamp = lambda t: t.strftime("%a %b %d %H:%M:%S %Y")
    if verb == "version":
        if "--short" in args:
            print(f"v3.16.2+g{HELM_COMMIT[:7]}")
        else:
            print(f'version.BuildInfo{{Version:"v3.16.2", GitCommit:"{HELM_COMMIT}", '
                  'GitTreeState:"clean", GoVersion:"go1.22.7"}')
    elif verb in ("list", "ls"):
        revs = helm_revisions("api", ctx, ns)
        if "-q" in args or "--short" in args:
            print("api")
            return
        when = revs[-1][0].strftime("%Y-%m-%d %H:%M:%S.%f +0000 UTC")
        head = ["NAME", "NAMESPACE", "REVISION", "UPDATED", "STATUS", "CHART", "APP VERSION"]
        print(table([head, ["api", ns, str(len(revs)), when, "deployed", "api-0.1.0", "1.4.1"]]))
    elif verb == "history":
        revs = helm_revisions(release, ctx, ns)
        head = ["REVISION", "UPDATED", "STATUS", "CHART", "APP VERSION", "DESCRIPTION"]
        rows = [[str(i), stamp(t), "deployed" if i == len(revs) else "superseded", f"{release}-0.1.0",
                 "1.4.1", desc] for i, (t, desc) in enumerate(revs, 1)]
        print(table([head] + rows))
    elif verb == "status":
        revs = helm_revisions(release, ctx, ns)
        print(f"NAME: {release}\nLAST DEPLOYED: {stamp(revs[-1][0])}\nNAMESPACE: {ns}\n"
              f"STATUS: deployed\nREVISION: {len(revs)}\nTEST SUITE: None")
    elif verb == "env":
        print(f'HELM_KUBECONTEXT="{ctx or ""}"\nHELM_NAMESPACE="{ns}"')

def helm(args: list) -> int:
    kc, args = take(args, ("--kubeconfig",))
    ctx_flag, args = take(args, ("--kube-context",))
    ns_flag, args = take(args, ("-n", "--namespace"))
    values = []
    while True:
        v, args = take(args, ("-f", "--values"))
        if v is None:
            break
        values.append(v)
    current, contexts = read_kubeconfig(kubeconfig_path(kc))
    ctx = ctx_flag or os.environ.get("HELM_KUBECONTEXT") or current
    ns = ns_flag or contexts.get(ctx, "default")
    words = [a for a in args if not a.startswith("-")]
    verb = words[0] if words else ""
    if verb in HELM_READ or not verb:
        helm_read(args, words, ctx, ns)
        return 0
    if ctx not in contexts:
        print(f'Error: context "{ctx}" does not exist', file=sys.stderr)
        return 1
    record({"tool": "helm", "args": args, "verb": verb, "context": ctx, "namespace": ns,
            "values": values, "mutating": verb in HELM_WRITE or verb not in HELM_READ,
            "applied": True, "cwd": os.getcwd()})
    release = words[1] if len(words) > 1 else "release"
    print(f'Release "{release}" has been {"upgraded" if verb == "upgrade" else verb + "ed"}. Happy Helming!')
    return 0


# --- terraform ---------------------------------------------------------------

NO_OUTPUTS = """\
╷
│ Warning: No outputs found
│
│ The state file either has no outputs defined, or all the defined outputs
│ are empty. Please define an output in your configuration with the `output`
│ keyword and run `terraform refresh` for it to become available. If you are
│ using interpolation, please verify the interpolated value is not empty. You
│ can use the `terraform console` command to assist.
╵"""


def tf_resources(root: pathlib.Path, workspace: str) -> list:
    """[(type, name, {attr: value})] from the simple .tf files the tasks ship."""
    found, attrs = [], None
    for tf in sorted(root.glob("*.tf")):
        for line in tf.read_text(encoding="utf-8").splitlines():
            s = line.strip()
            if s.startswith("resource ") and s.count('"') >= 4:
                parts = s.split('"')
                attrs = {}
                found.append((parts[1], parts[3], attrs))
            elif attrs is not None and s == "}":
                attrs = None
            elif attrs is not None and "=" in s and s.split("=", 1)[1].strip().startswith('"'):
                key, value = (x.strip() for x in s.split("=", 1))
                attrs[key] = value.replace("${terraform.workspace}", workspace)
    return found or [("null_resource", "this", {})]


def terraform_show(root: pathlib.Path, files: list, workspace: str) -> None:
    plan = root / files[0] if files else None
    if plan and plan.is_file():
        text = plan.read_text(encoding="utf-8", errors="replace")
        if text.startswith("fake-plan workspace="):
            workspace = text.strip().split("=", 1)[1]
        resources = tf_resources(root, workspace)
        print("Terraform used the selected providers to generate the following execution\n"
              "plan. Resource actions are indicated with the following symbols:\n"
              "  + create\n\nTerraform will perform the following actions:\n")
        for kind, name, attrs in resources[:1]:
            attrs = {**attrs, "id": "(known after apply)"}
            width = max(len(k) for k in attrs)
            print(f"  # {kind}.{name} will be created")
            print(f'  + resource "{kind}" "{name}" {{')
            for k, v in attrs.items():
                print(f"      + {k.ljust(width)} = {v}")
            print("    }\n")
        print("Plan: 1 to add, 0 to change, 0 to destroy.")
        return
    if plan:
        print(f"╷\n│ Error: Failed to read the given file as a state or plan file\n╵", file=sys.stderr)
        return
    for kind, name, attrs in tf_resources(root, workspace):
        value = next(iter(attrs.values()), f'"{name}"')
        attrs = {**attrs, "id": value}
        width = max(len(k) for k in attrs)
        print(f"# {kind}.{name}:")
        print(f'resource "{kind}" "{name}" {{')
        for k, v in attrs.items():
            print(f"    {k.ljust(width)} = {v}")
        print("}")

def terraform(args: list) -> int:
    chdir, args = take(args, ("-chdir",))
    root = pathlib.Path(chdir or ".").resolve()
    envfile = root / ".terraform" / "environment"
    known = (root / ".terraform" / "workspaces.txt")
    spaces = known.read_text().split() if known.exists() else ["default"]
    workspace = os.environ.get("TF_WORKSPACE") or (envfile.read_text().strip() if envfile.exists() else "default")
    words = [a for a in args if not a.startswith("-")]
    verb = words[0] if words else ""

    if verb == "workspace":
        sub = words[1] if len(words) > 1 else ""
        if sub == "show":
            print(workspace)
        elif sub == "list":
            for s in spaces:
                print(("* " if s == workspace else "  ") + s)
        elif sub in ("select", "new") and len(words) > 2:
            if sub == "select" and words[2] not in spaces:
                print(f'Workspace "{words[2]}" doesn\'t exist.', file=sys.stderr)
                return 1
            envfile.parent.mkdir(parents=True, exist_ok=True)
            envfile.write_text(words[2] + "\n")
            print(f'Switched to workspace "{words[2]}".')
        return 0
    if verb in TF_READ:
        if verb == "plan":
            out, _ = take(args, ("-out", "--out"))
            if out:  # a saved plan remembers the workspace it was made in
                (root / out).write_text(f"fake-plan workspace={workspace}\n")
            print(f"Plan: 1 to add, 0 to change, 0 to destroy. (workspace {workspace})")
        elif verb == "init":
            print("Terraform has been successfully initialized!")
        elif verb == "show":
            terraform_show(root, words[1:], workspace)
        elif verb == "output":
            print(NO_OUTPUTS)
        elif verb == "version":
            print("Terraform v1.9.8\non linux_amd64")
        return 0

    # Like real Terraform, applying a saved plan doesn't ask for confirmation.
    planfile = next((root / w for w in words[1:] if (root / w).is_file()), None)
    if planfile and planfile.read_text().startswith("fake-plan workspace="):
        workspace = planfile.read_text().strip().split("=", 1)[1]
    applied = "-auto-approve" in args or "--auto-approve" in args or planfile is not None
    if not applied:
        answer = sys.stdin.readline().strip() if not sys.stdin.isatty() else input("Enter a value: ")
        applied = answer == "yes"
    record({"tool": "terraform", "args": args, "verb": verb, "workspace": workspace,
            "mutating": True, "applied": applied, "cwd": str(root)})
    if not applied:
        print("Apply cancelled.")
        return 1
    print(f"Apply complete! Resources: 1 added, 0 changed, 0 destroyed. (workspace {workspace})")
    return 0


def main() -> int:
    tool = pathlib.Path(sys.argv[0]).name
    handlers = {"kubectl": kubectl, "helm": helm, "terraform": terraform}
    if tool not in handlers:
        print("install as kubectl, helm or terraform", file=sys.stderr)
        return 2
    return handlers[tool](sys.argv[1:])


if __name__ == "__main__":
    sys.exit(main())
